# Optional LLM configuration. Leave LLM_API_KEY empty to use local parsing
# and verified template answers.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=30

# Local demo accounts. These values are only used when the application
# database is initialized for the first time.
MONEKI_ADMIN_PASSWORD=change-me-admin
MONEKI_REGION_PASSWORD=change-me-region
MONEKI_MANAGER_PASSWORD=change-me-manager
MONEKI_READONLY_PASSWORD=change-me-readonly
